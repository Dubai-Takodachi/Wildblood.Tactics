@page "/"
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Authorization
@using MongoDB.Driver;
@using MongoDB.Bson;
@using Wildblood.Tactics.Entities
@using Wildblood.Tactics.Models
@using Wildblood.Tactics.Services
@using System.Text.Json
@inject IMongoDatabase  Database;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject ITemporaryTacticService TemporaryTacticService
@rendermode InteractiveServer
<PageTitle>Home</PageTitle>

<article Style="padding-left: 2rem; padding-right: 1.5rem;">
    <AuthorizeView>
        <Authorized>
            <div>
                <h1>Welcome To Wildblood.Tactics!</h1>
                <input type="button" class="btn btn-primary" value="Create New Tactic" @onclick="CreateNewTactic" />
            </div>
        </Authorized>
        <NotAuthorized>
            <div>
                <h1>Welcome To Wildblood.Tactics!</h1>
                <p>You are not logged in. Choose how you want to create a tactic:</p>
                <div style="display: flex; flex-direction: column; gap: 1rem; max-width: 400px;">
                    <input type="button" class="btn btn-primary" value="Create Tactic and Save" @onclick="CreateAnonymousSavedTactic" />
                    <input type="button" class="btn btn-secondary" value="Create Tactic Without Saving" @onclick="CreateAnonymousTemporaryTactic" />
                    <input type="button" class="btn btn-info" value="Import from JSON" @onclick="ImportFromJson" />
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</article>

<InputFile @ref="fileInput" style="display: none;" OnChange="HandleFileSelected" accept=".json" />

@code {

    private InputFile? fileInput;

    private async Task CreateNewTactic()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var userId = user.FindFirst(c => c.Type == "sub")?.Value ??
                user.FindFirst(c => c.Type == "nameidentifier")?.Value ?? user.Identity.Name;
            var tactic = CreateTacticDocument(userId, user.Identity.Name);
            var collection = Database.GetCollection<Tactic>("Tactics");
            collection.InsertOne(tactic);
            NavigationManager.NavigateTo("/tactics/" + tactic.Id);
        }
    }

    private async Task CreateAnonymousSavedTactic()
    {
        var tactic = CreateTacticDocument(null, "Anonymous");
        var collection = Database.GetCollection<Tactic>("Tactics");
        collection.InsertOne(tactic);
        NavigationManager.NavigateTo("/tactics/" + tactic.Id);
    }

    private async Task CreateAnonymousTemporaryTactic()
    {
        var tactic = CreateTacticDocument(null, "Anonymous");
        // Store in service
        TemporaryTacticService.SetTemporaryTactic(tactic);
        NavigationManager.NavigateTo("/tactics/temp");
    }

    private async Task ImportFromJson()
    {
        // Trigger the file input click
        if (fileInput?.Element != null)
        {
            await JSRuntime.InvokeVoidAsync("eval", $"document.querySelector('input[type=file]').click()");
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
                using var reader = new StreamReader(stream);
                var json = await reader.ReadToEndAsync();
                
                // Validate JSON by deserializing
                var tactic = JsonSerializer.Deserialize<Tactic>(json);
                if (tactic != null)
                {
                    // Store in service and navigate
                    TemporaryTacticService.SetTemporaryTactic(tactic);
                    NavigationManager.NavigateTo("/tactics/temp");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading JSON: {ex.Message}");
            }
        }
    }

    private Tactic CreateTacticDocument(string? user, string userName) {
        return new Tactic
        {
            Id = ObjectId.GenerateNewId().ToString(),
            Name = "New Tactic",
            UserId = user,
            Folders = new List<Folder> {
                new Folder {
                    Id = ObjectId.GenerateNewId().ToString(),
                    Name = "Folder 1",
                    Slides = new List<Slide> {
                        new Slide {
                            Id = ObjectId.GenerateNewId().ToString(),
                            Name = "Slide 1",
                            Entities = new List<Entity>(),
                        }
                    }
                }
            },
            Members = new List<MemberRole>
            {
                new MemberRole
                {
                    Name = userName,
                    Roles = Role.Owner,
                }
            },
        };
    }
}