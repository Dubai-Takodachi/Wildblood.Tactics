@page "/tactics/{ID}"

@namespace Wildblood.Tactics.Components.Pages

@using Wildblood.Tactics.Components.MainPage
@using Wildblood.Tactics.Services

@inject ITacticExplorerService explorer;
@inject ITemporaryTacticService tempTacticService;
@inject NavigationManager NavigationManager

@rendermode InteractiveServer

<div class="parent">
    <TacticCanvas/>
    <MudCard Style="grid-area: 1/2/6/3; overflow-y: scroll; overflow-x: hidden">
        <TacticMapSelector/>
        <TacticTool/>
        <div style="grid-area: 5/2/span 3/2;">
            <TacticExplorer/>
            <TacticMemberList/>
        </div>
    </MudCard>
</div>

@code {

    [Parameter]
    public string? ID { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Check if this is the temporary tactics route
        var uri = new Uri(NavigationManager.Uri);
        if (uri.AbsolutePath == "/tactics/temp")
        {
            // Load temporary tactic
            var tempTactic = tempTacticService.CurrentTemporaryTactic;
            if (tempTactic != null)
            {
                await explorer.LoadTemporaryTactic(tempTactic);
            }
        }
        else if (ID != null)
        {
            await explorer.ChangeTactic(ID);
        }
    }
}