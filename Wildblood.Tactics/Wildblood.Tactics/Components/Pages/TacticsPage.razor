@page "/tactics/{ID}"

@namespace Wildblood.Tactics.Components.Pages

@using Blazored.LocalStorage
@using MongoDB.Bson
@using Wildblood.Tactics.Components.MainPage
@using Wildblood.Tactics.Entities
@using Wildblood.Tactics.Models
@using Wildblood.Tactics.Services

@inject ILocalStorageService localStorageService
@inject ITacticExplorerService explorer;
@inject ITemporaryTacticService tempTacticService;
@inject NavigationManager NavigationManager

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="parent">
    <TacticCanvas/>
    <MudCard Style="grid-area: 1/2/6/3; overflow-y: scroll; overflow-x: hidden">
        <TacticMapSelector/>
        <TacticTool/>
        <div style="grid-area: 5/2/span 3/2;">
            <TacticExplorer/>
            <TacticMemberList/>
        </div>
    </MudCard>
</div>

@code {

    [Parameter]
    public string? ID { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "temp")]
    public bool? IsTemporary { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsTemporary == true && ID != null)
        {
            var tactic = CreateTacticDocument(null, "Anonymous");
            await explorer.LoadTemporaryTactic(tactic);
        }
        else if (ID != null)
        {
            await explorer.ChangeTactic(ID);
        }
    }

    private Tactic CreateTacticDocument(string? user, string userName)
    {
        return new Tactic
        {
            Id = ID,
            Name = "New Tactic",
            UserId = user,
            Folders = new List<Folder> {
                new Folder {
                    Id = ObjectId.GenerateNewId().ToString(),
                    Name = "Folder 1",
                    Slides = new List<Slide> {
                        new Slide {
                            Id = ObjectId.GenerateNewId().ToString(),
                            Name = "Slide 1",
                            Entities = new List<Entity>(),
                        }
                    }
                }
            },
            Members = new List<MemberRole>
            {
                new MemberRole
                {
                    Name = userName,
                    Roles = Role.Owner,
                }
            },
        };
    }
}